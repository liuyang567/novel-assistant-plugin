{
  "name": "novel-writing-assistant",
  "displayName": "小说创作助手",
  "description": "字数统计（排除空白字符）、敏感词检测、码字计时与速率 - 专为小说/网文创作优化",
  "version": "1.0.0",
  "publisher": "NeoVita",
  "author": {
    "name": "NeoVita"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "小说",
    "网文",
    "字数统计",
    "计时",
    "敏感词",
    "writing",
    "novel",
    "word count",
    "timer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/liuyang567/novel-assistant-plugin"
  },
  "bugs": {
    "url": "https://github.com/liuyang567/novel-assistant-plugin/issues"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "novel-plugin.showCounts",
        "title": "显示字数详情",
        "category": "小说助手"
      }
    ]
  }
}
